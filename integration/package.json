{
  "name": "@theokit/plugins-integration",
  "version": "0.0.0",
  "private": true,
  "description": "Live end-to-end tests against the real provider APIs. Deliberately has no \"test\" script: `pnpm test` must never spend money or send real email.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "consumer": "vitest run tests/consumer",
    "offline": "vitest run tests/consumer .offline.test.ts",
    "integration": "vitest run",
    "integration:watch": "vitest",
    "env:example": "tsx scripts/env-example.ts",
    "flow:github": "node scripts/full-flow-github.mjs",
    "flow:stripe-webhook": "node scripts/full-flow-stripe-webhook.mjs",
    "readiness": "vitest run tests/readiness.offline.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theokit/auth-github": "workspace:*",
    "@theokit/auth-google": "workspace:*",
    "@theokit/auth-magic-link": "workspace:^",
    "@theokit/plugin-copilot": "workspace:*",
    "@theokit/plugin-db-drizzle": "workspace:^",
    "@theokit/plugin-email": "workspace:*",
    "@theokit/plugin-payments": "workspace:*",
    "@theokit/plugin-realtime": "workspace:^",
    "@theokit/plugin-voice": "workspace:*",
    "@theokit/sdk": ">=2.18.0 <3.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "smtp-server": "^3.19.3",
    "stripe": "^14.8.0",
    "theokit": "^0.48.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
