{
  "name": "theokit-plugins-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Official first-party plugins for the TheoKit framework",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r --filter='./packages/*' run test",
    "e2e": "pnpm --filter @theokit/plugins-e2e e2e",
    "e2e:readiness": "pnpm --filter @theokit/plugins-e2e readiness",
    "typecheck": "tsc --noEmit",
    "check:cycles": "npx --yes madge --circular --extensions ts,tsx packages/*/src",
    "check:manifests": "node scripts/validate-manifests.mjs",
    "lint": "eslint 'packages/**/*.{ts,tsx,mts,cts}' --max-warnings=0 --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .githooks 2>/dev/null || true",
    "e2e:consumer": "pnpm --filter @theokit/plugins-e2e consumer"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "prettier": "^3.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-plugins.git"
  },
  "homepage": "https://github.com/usetheokit/theokit-plugins#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-plugins/issues"
  },
  "license": "Apache-2.0"
}
