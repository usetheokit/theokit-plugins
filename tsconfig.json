{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "files": [],
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "**/.tsup"]
}
