{
  "name": "@theokit/plugin-db-drizzle",
  "version": "0.6.0",
  "description": "drizzle-kit helpers for TheoKit apps: builds the drizzle-kit command lines and the drizzle.config.ts for your own db scripts, plus a drizzle-kit studio tab descriptor. Registers nothing at runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.37.0",
    "theokit": ">=0.50.1 || >=0.65.0-0 <0.66.0"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "theokit": ">=0.50.1 || >=0.65.0-0 <0.66.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "theokit",
    "theokit-plugin",
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "database",
    "orm",
    "migrations"
  ],
  "author": "@theokit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-plugins.git",
    "directory": "packages/plugin-db-drizzle"
  },
  "homepage": "https://github.com/usetheokit/theokit-plugins/tree/main/packages/plugin-db-drizzle#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-plugins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false
}
