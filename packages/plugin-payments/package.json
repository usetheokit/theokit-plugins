{
  "name": "@theokit/plugin-payments",
  "version": "0.3.1",
  "description": "Multi-provider payments plugin for TheoKit \u2014 one neutral PaymentProvider contract with Stripe and AbacatePay (PIX) behind subpath exports, webhook signature verification, idempotent dispatch, and PIX as a typed optional capability.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "import": "./dist/stripe.js"
    },
    "./abacatepay": {
      "types": "./dist/abacatepay.d.ts",
      "import": "./dist/abacatepay.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "reflect-metadata": "^0.2.0",
    "stripe": ">=14.0.0",
    "theokit": ">=0.2.3"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "stripe": "^14.8.0",
    "theokit": "^0.48.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "theokit",
    "theokit-plugin",
    "stripe",
    "payments",
    "webhooks",
    "checkout",
    "subscriptions",
    "abacatepay",
    "pix",
    "brazil"
  ],
  "author": "@theokit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-plugins.git",
    "directory": "packages/plugin-payments"
  },
  "homepage": "https://github.com/usetheokit/theokit-plugins/tree/main/packages/plugin-payments#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-plugins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
