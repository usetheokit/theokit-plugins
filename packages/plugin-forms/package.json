{
  "name": "@theokit/plugin-forms",
  "version": "0.5.2",
  "description": "Declarative form binding for TheoKit: zod + react-hook-form + useAction. Ships <TheoForm action={actions.X}> + <TheoField name> + applyActionErrorsToForm adapter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@usetheo/ui": ">=0.22.0 <1",
    "react": ">=19.0.0",
    "react-hook-form": "^7.50.0",
    "theokit": ">=0.52.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@testing-library/react": "^16.1.0",
    "@theokit/ui": "^1.3.2",
    "@types/react": "^19.0.0",
    "@usetheo/ui": "^0.35.1",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.50.0",
    "react-router": "^7.0.0",
    "theokit": ">=0.52.1",
    "tsup": "^8.5.0",
    "vitest": "^4.1.8",
    "zod": "^4.0.0"
  },
  "publishConfig": {
