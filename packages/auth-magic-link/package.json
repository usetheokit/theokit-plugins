{
  "name": "@theokit/auth-magic-link",
  "version": "0.4.0",
  "description": "Email magic-link provider for @theokit/sdk/server/auth. Pluggable MagicLinkStore + email-callback for any transport (Resend/SendGrid/SMTP).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@theokit/sdk": ">=2.18.0",
    "theokit": ">=0.48.7"
  },
  "devDependencies": {
    "@theokit/sdk": "^2.18.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^11.10.0",
    "theokit": "^0.48.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "theokit",
    "theokit-plugin",
    "auth",
    "magic-link",
    "email",
    "passwordless"
  ],
  "author": "@theokit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-plugins.git",
    "directory": "packages/auth-magic-link"
  },
  "homepage": "https://github.com/usetheokit/theokit-plugins/tree/main/packages/auth-magic-link#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-plugins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
