{
  "name": "@theokit/plugin-canvas",
  "version": "0.8.1-next.0",
  "description": "Canvas plugin for TheoKit — artifact protocol (markdown/code/svg/diff/whiteboard/slide/mermaid/html/image) + side-panel UI + agent custom tool.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
